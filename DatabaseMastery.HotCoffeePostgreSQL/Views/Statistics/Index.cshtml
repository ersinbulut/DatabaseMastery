@{
    ViewData["Title"] = "Statistics";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

@await Component.InvokeAsync("_StatisticsStyleComponentPartial")

@await Component.InvokeAsync("_StatisticsHeroComponentPartial")

@await Component.InvokeAsync("_StatisticsKpiComponentPartial")

@await Component.InvokeAsync("_StatisticsBigGridComponentPartial")


<!-- ROW 1 -->
<div class="row g-3 mb-3">
    <!-- Durum -->
    @await Component.InvokeAsync("_StatisticsReservationStatusComponentPartial")
    @await Component.InvokeAsync("_StatisticsCategoryTableComponentPartial")
    @await Component.InvokeAsync("_StatisticsRatingDistComponentPartial")


    <!-- Kategori Tablosu -->
   

    <!-- Puan Dağılımı -->
  
</div>

<!-- ROW 2 -->
<div class="row g-3 mb-3">

    <!-- En İyi Ürünler -->
    <div class="col-xl-4">
        <div class="sec-card" style="animation-delay:.18s;">
            <div class="card-head">
                <div class="ch-icon" style="background:var(--yellow-soft);"><i class="bi bi-trophy-fill" style="color:var(--yellow);"></i></div>
                <div><div class="sec-title">En İyi Ürünler</div><div class="sec-sub">Puana göre sıralı top 5</div></div>
            </div>
            <div class="card-body">
                <div class="rank-list">
                    @{
                        var prods = new[] { new { n = 1, em = "🍖", name = "Kuzu İncik", cat = "Ana Yemekler", rev = "42", rat = "4.9" }, new { n = 2, em = "🍮", name = "Kazandibi", cat = "Tatlılar", rev = "38", rat = "4.8" }, new { n = 3, em = "🥗", name = "Semizotu Salatası", cat = "Başlangıçlar", rev = "29", rat = "4.7" }, new { n = 4, em = "🥩", name = "Dana Antrikot", cat = "Ana Yemekler", rev = "55", rat = "4.6" }, new { n = 5, em = "🍹", name = "Limonata", cat = "İçecekler", rev = "61", rat = "4.5" }, };
                        var rnc = new[] { "rn-1", "rn-2", "rn-3", "rn-o", "rn-o" };
                    }
                    @foreach (var p in prods)
                    {
                        <div class="rank-item">
                            <div class="rank-num @rnc[p.n - 1]">@p.n</div>
                            <div class="rank-em">@p.em</div>
                            <div><div class="rank-name">@p.name</div><div class="rank-meta">@p.cat · @p.rev yorum</div></div>
                            <div class="rank-right"><div class="rank-val">@p.rat</div><div class="rank-badge">★★★★★</div></div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Isı Haritası -->
    <div class="col-xl-5">
        <div class="sec-card" style="animation-delay:.20s;">
            <div class="card-head">
                <div class="ch-icon" style="background:var(--purple-soft);"><i class="bi bi-clock-fill" style="color:var(--purple);"></i></div>
                <div><div class="sec-title">Rezervasyon Yoğunluğu</div><div class="sec-sub">Gün & saat bazlı ısı haritası</div></div>
            </div>
            <div class="card-body">
                <div class="heatmap-grid">
                    <div></div>
                    @foreach (var d in new[] { "Pzt", "Sal", "Çar", "Per", "Cum", "Cmt", "Paz" })
                    {
                        <div class="hm-day-lbl">@d</div>
                    }
                    @{
                        var hrs = new[] { "12:00", "14:00", "16:00", "18:00", "20:00", "22:00" };
                        var hd = new int[,] { { 2, 3, 2, 4, 5, 8, 7 }, { 3, 4, 3, 5, 6, 9, 8 }, { 2, 2, 3, 3, 5, 7, 6 }, { 5, 6, 7, 8, 12, 15, 13 }, { 8, 9, 10, 11, 14, 18, 16 }, { 6, 7, 8, 9, 12, 14, 12 } };
                        var hmc = new[] { "#fdf5e6", "#fbe8c0", "#f8d48a", "#f5c054", "#e6a03c", "#c8861e", "#a06815" };
                        var dys = new[] { "Pzt", "Sal", "Çar", "Per", "Cum", "Cmt", "Paz" };
                    }
                    @for (int hr = 0; hr < hrs.Length; hr++)
                    {
                        <div class="hm-hr-lbl">@hrs[hr]</div>
                        @for (int dy = 0; dy < 7; dy++)
                        {
                            var v = hd[hr, dy]; var ci = Math.Min((int)Math.Round(v / 3.0), hmc.Length - 1);
                            <div class="hm-cell" style="background:@hmc[ci];" data-tip="@dys[dy] @hrs[hr] — @v rezervasyon"></div>
                        }
                    }
                </div>
                <div class="d-flex align-items-center gap-2 mt-3" style="font-size:11.5px;color:var(--muted);">
                    <span>Az</span>
                    @foreach (var c in new[] { "#fdf5e6", "#fbe8c0", "#f8d48a", "#f5c054", "#e6a03c", "#c8861e", "#a06815" })
                    {
                        <div style="width:18px;height:10px;border-radius:3px;background:@c;"></div>
                    }
                    <span>Çok</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Müşteri Metrikleri -->
    <div class="col-xl-3">
        <div class="sec-card" style="animation-delay:.22s;">
            <div class="card-head">
                <div class="ch-icon" style="background:var(--purple-soft);"><i class="bi bi-people-fill" style="color:var(--purple);"></i></div>
                <div><div class="sec-title">Müşteri Metrikleri</div><div class="sec-sub">Genel profil</div></div>
            </div>
            <div class="card-body">
                <div class="mini-tl">
                    @{
                        var mets = new[] { new { bg = "var(--accent-soft)", ic = "bi-person-check-fill", c = "var(--accent-dark)", t = "Tekrar Gelen", s = "Sadık müşteri", v = "%34" }, new { bg = "var(--green-soft)", ic = "bi-person-plus-fill", c = "var(--green)", t = "Yeni Müşteri", s = "Bu ay", v = "47" }, new { bg = "var(--blue-soft)", ic = "bi-people-fill", c = "var(--blue)", t = "Ort. Grup", s = "Kişi/rezervasyon", v = "3.8" }, new { bg = "var(--yellow-soft)", ic = "bi-star-fill", c = "var(--yellow)", t = "Yorum Yapan", s = "Müşteri oranı", v = "%68" }, new { bg = "var(--purple-soft)", ic = "bi-calendar-heart-fill", c = "var(--purple)", t = "En Yoğun Gün", s = "Haftalık bazda", v = "Cmt" }, new { bg = "var(--teal-soft)", ic = "bi-clock-fill", c = "var(--teal)", t = "En Yoğun Saat", s = "Rezervasyon saati", v = "20:00" }, };
                    }
                    @foreach (var m in mets)
                    {
                        <div class="mtl-item">
                            <div class="mtl-icon" style="background:@m.bg;"><i class="bi @m.ic" style="color:@m.c;"></i></div>
                            <div><div class="mtl-title">@m.t</div><div class="mtl-sub">@m.s</div></div>
                            <div class="mtl-val">@m.v</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- METRIC TILES -->
<div class="metric-grid">
    @{
        var tiles = new[] { new { cls = "mt-amber", icon = "bi-calendar-day-fill", ic = "#c8861e", lbl = "Bugünkü Rez.", val = "7" }, new { cls = "mt-sky", icon = "bi-calendar-week-fill", ic = "#2563eb", lbl = "Bu Haftaki Rez.", val = "34" }, new { cls = "mt-sage", icon = "bi-calendar-month-fill", ic = "#16a34a", lbl = "Bu Ayki Rez.", val = "112" }, new { cls = "mt-lemon", icon = "bi-eye-fill", ic = "#b45309", lbl = "Yayındaki Yorum", val = "428" }, new { cls = "mt-rose", icon = "bi-eye-slash-fill", ic = "#dc2626", lbl = "Gizli Yorum", val = "72" }, new { cls = "mt-mint", icon = "bi-basket3-fill", ic = "#0d9488", lbl = "Aktif Ürün", val = "62" }, new { cls = "mt-lavender", icon = "bi-tags-fill", ic = "#7c3aed", lbl = "Aktif Kategori", val = "4" }, new { cls = "mt-peach", icon = "bi-person-fill-check", ic = "#c2410c", lbl = "Toplam Müşteri", val = "384" }, };
    }
    @foreach (var t in tiles)
    {
        <div class="metric-tile @t.cls">
            <div class="mt-icon"><i class="bi @t.icon" style="color:@t.ic;font-size:17px;"></i></div>
            <div><div class="mt-num">@t.val</div><div class="mt-lbl">@t.lbl</div></div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function(){
            var tr=['Pazar','Pazartesi','Salı','Çarşamba','Perşembe','Cuma','Cumartesi'];
            var mo=['Ocak','Şubat','Mart','Nisan','Mayıs','Haziran','Temmuz','Ağustos','Eylül','Ekim','Kasım','Aralık'];
            var d=new Date();
            document.getElementById('liveDate').textContent=tr[d.getDay()]+', '+d.getDate()+' '+mo[d.getMonth()]+' '+d.getFullYear();
        })();
    </script>
}